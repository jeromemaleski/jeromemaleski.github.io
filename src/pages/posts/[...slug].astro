---
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { getPosts, formatDate } from '../../lib/posts';

export async function getStaticPaths() {
  const posts = await getPosts();
  return posts.map((post, i) => ({
    params: { slug: post.id },
    // posts are newest first, so "newer" is i-1 and "older" is i+1
    props: { post, newer: posts[i - 1], older: posts[i + 1] },
  }));
}
const { post, newer, older } = Astro.props;
const { Content } = await render(post);
const { title, date, updated, description } = post.data;
---
<Base title={`${title} · Jerome Maleski`} description={description}>
  <nav class="back"><a href="/">← Jerome Maleski</a></nav>
  <article>
    <h1>{title}</h1>
    <p class="meta">
      <time datetime={date.toISOString()}>{formatDate(date)}</time>
      {updated && <> · updated <time datetime={updated.toISOString()}>{formatDate(updated)}</time></>}
    </p>
    <Content />
  </article>
  <footer class="post-nav">
    <span>{older && <a href={`/posts/${older.id}/`}>← {older.data.title}</a>}</span>
    <span>{newer && <a href={`/posts/${newer.id}/`}>{newer.data.title} →</a>}</span>
  </footer>
</Base>
